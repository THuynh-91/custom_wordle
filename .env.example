# Backend API URL (for production, set to your Render backend URL)
VITE_API_URL=http://localhost:8080
# Socket.io connection URL (must match backend PORT)
VITE_API_BASE_URL=http://localhost:8080

# Database (if needed in future)
# DATABASE_URL=

# Frontend URL for CORS (backend) — comma-separate multiple origins if needed
FRONTEND_URL=http://localhost:5173

# Comma-separated Vercel project slugs allowed for CORS preview deployments.
# Only <slug>.vercel.app / <slug>-*.vercel.app origins are accepted (prevents
# arbitrary *.vercel.app sites from making credentialed requests).
VERCEL_PROJECT_SLUGS=custom-wordle

# Rate limiting (backend). Global limiter defaults shown; abuse-prone routes
# (AI-move, feedback) have their own stricter limits in code.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# GitHub Personal Access Token for feedback submissions
# Generate at: https://github.com/settings/tokens/new
# Required scopes: public_repo (to create issues)
GITHUB_TOKEN=your_github_token_here
